# Neon — pooled para runtime, directa para migraciones
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generar con: npx auth secret
AUTH_SECRET=""

# Necesaria detrás de un proxy (Render, Railway); en Vercel se detecta sola
AUTH_TRUST_HOST=true

# Google Books — https://console.cloud.google.com, habilitar "Books API"
GOOGLE_BOOKS_API_KEY=""